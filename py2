import numpy as np
import matplotlib.pyplot as plt

N = np.array([3, 4, 7, 9, 12])
Q = np.sqrt(3 * N)
channels = 336 / N
SI = 10 * np.log10(Q**4 / 6)

print("N   Q     Channels   S/I(dB)")
for n, q, c, s in zip(N, Q, channels, SI):
    print(n, round(q, 2), round(c, 1), round(s, 2))

plt.plot(N, SI, 'o-', label="S/I (dB)")
plt.plot(N, channels, 's--', label="Channels per cell")
plt.xlabel("Cluster Size")
plt.ylabel("Values")
plt.title("Capacity vs Interference")
plt.legend()
plt.savefig("reuse.png")
plt.show()